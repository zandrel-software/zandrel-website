<footer class="site-footer">

    <div class="container">

        <div class="site-footer__main">

            <div class="site-footer__brand">

                <a class="site-footer__logo-link"
                   href="#home"
                   aria-label="Zandrel - Ir al inicio">

                    <img class="site-footer__logo"
                         src="images/brand/zandrel-logo-horizontal-transparent.png"
                         alt="Zandrel" />

                </a>

                <p class="site-footer__description">
                    Software pensado alrededor de necesidades reales,
                    con soluciones claras, profesionales y adaptadas
                    a cada negocio.
                </p>

            </div>

            <nav class="site-footer__navigation"
                 aria-label="Navegación del pie de página">

                <span class="site-footer__heading">
                    Navegación
                </span>

                <div class="site-footer__links">

                    <a href="#home">
                        Inicio
                    </a>

                    <a href="#services">
                        Servicios
                    </a>

                    <a href="#process">
                        Cómo trabajamos
                    </a>

                    <a href="#about">
                        Nosotros
                    </a>

                </div>

            </nav>

            <div class="site-footer__contact">

                <span class="site-footer__heading">
                    Hablemos
                </span>

                <p class="site-footer__contact-description">
                    Cuéntanos qué necesita tu negocio.
                    Nosotros te ayudamos a encontrar la solución.
                </p>

                <a class="site-footer__action"
                   href="@BrandLinks.WhatsApp"
                   target="_blank"
                   rel="noopener noreferrer">

                    <svg class="site-footer__action-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8
                        8.5 8.5 0 0 1-7.6 4.7
                        8.4 8.4 0 0 1-3.8-.9
                        L3 21l1.9-5.7
                        A8.4 8.4 0 0 1 4 11.5
                        a8.5 8.5 0 0 1 4.7-7.6
                        A8.4 8.4 0 0 1 12.5 3
                        h.5
                        a8.5 8.5 0 0 1 8 8z" />

                    </svg>

                    Hablar por WhatsApp

                    <svg class="site-footer__action-arrow"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M5 12h14M13 6l6 6-6 6" />

                    </svg>

                </a>

            </div>

        </div>

        <div class="site-footer__bottom">

            <p>
                © @DateTime.Now.Year Zandrel.
                Todos los derechos reservados.
            </p>

            <a href="#home"
               class="site-footer__back-to-top">

                Volver al inicio

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M12 19V5" />
                    <path d="m6 11 6-6 6 6" />

                </svg>

            </a>

        </div>

    </div>

</footer>