@using Zandrel.Web.Constants

<section id="contact"
         class="final-cta section"
         aria-labelledby="final-cta-title">

    <div class="container">

        <div class="final-cta__panel">

            <div class="final-cta__glow
                final-cta__glow--primary"
                 aria-hidden="true">
            </div>

            <div class="final-cta__glow
                final-cta__glow--secondary"
                 aria-hidden="true">
            </div>

            <div class="final-cta__content">

                <span class="final-cta__eyebrow">
                    Hablemos de tu proyecto
                </span>

                <h2 id="final-cta-title"
                    class="final-cta__title">
                    ¿Tienes una idea o algo que quieres mejorar
                    en tu negocio?
                </h2>

                <p class="final-cta__description">
                    Cuando nos escribes, hablas directamente con una persona,
                    no con un bot. Cuéntanos qué quieres lograr y nosotros
                    te ayudamos a encontrar una solución adecuada para
                    tu negocio y tu presupuesto.
                </p>

                <a class="final-cta__action"
                   href="@BrandLinks.WhatsApp"
                   target="_blank"
                   rel="noopener noreferrer">

                    <svg class="final-cta__action-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8
                        8.5 8.5 0 0 1-7.6 4.7
                        8.4 8.4 0 0 1-3.8-.9
                        L3 21l1.9-5.7
                        A8.4 8.4 0 0 1 4 11.5
                        a8.5 8.5 0 0 1 4.7-7.6
                        A8.4 8.4 0 0 1 12.5 3
                        h.5
                        a8.5 8.5 0 0 1 8 8z" />

                    </svg>

                    Cuéntanos tu idea por WhatsApp

                    <svg class="final-cta__action-arrow"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M5 12h14M13 6l6 6-6 6" />

                    </svg>

                </a>

                <ul class="final-cta__assurances"
                    aria-label="Compromisos principales de Zandrel">

                    <li>

                        <span aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M20 6 9 17l-5-5" />

                            </svg>

                        </span>

                        Sin tecnicismos

                    </li>

                    <li>

                        <span aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M20 6 9 17l-5-5" />

                            </svg>

                        </span>

                        Alcance claro

                    </li>

                    <li>

                        <span aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M20 6 9 17l-5-5" />

                            </svg>

                        </span>

                        Mantenimiento incluido

                    </li>

                </ul>

            </div>

            <div class="final-cta__visual"
                 aria-hidden="true">

                <div class="final-cta-card">

                    <div class="final-cta-card__header">

                        <div class="final-cta-card__brand">

                            <img src="images/brand/zandrel-mark-transparent.png"
                                 alt="" />

                            <span>
                                Zandrel
                            </span>

                        </div>

                        <span class="final-cta-card__status">

                            <span></span>

                            Nuevo proyecto

                        </span>

                    </div>

                    <div class="final-cta-card__conversation">

                        <div class="final-cta-card__message
                            final-cta-card__message--client">

                            <span>
                                Cliente
                            </span>

                            <p>
                                Tengo una idea para mejorar mi negocio,
                                pero no sé qué sistema necesito.
                            </p>

                        </div>

                        <div class="final-cta-card__message
                            final-cta-card__message--zandrel">

                            <span>
                                Zandrel
                            </span>

                            <p>
                                Cuéntanos qué quieres resolver.
                                Nosotros nos encargamos de encontrar
                                la solución adecuada.
                            </p>

                        </div>

                    </div>

                    <div class="final-cta-card__footer">

                        <span class="final-cta-card__footer-icon">

                            <svg viewBox="0 0 24 24">

                                <path d="M20 6 9 17l-5-5" />

                            </svg>

                        </span>

                        <div>

                            <strong>
                                Empecemos por tu necesidad
                            </strong>

                            <span>
                                La tecnología viene después.
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>