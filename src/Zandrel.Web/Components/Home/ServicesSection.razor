@using Zandrel.Web.Constants

<section id="services"
         class="services section"
         aria-labelledby="services-title">

    <div class="container">

        <div class="services__heading">

            <div class="services__heading-content">

                <span class="eyebrow">
                    Servicios
                </span>

                <h2 id="services-title"
                    class="services__title">
                    Soluciones para necesidades reales de tu negocio.
                </h2>

            </div>

            <p class="services__description">
                No necesitas saber qué tecnología utilizar.
                Cuéntanos qué quieres mejorar o resolver y nosotros
                determinamos la solución adecuada.
            </p>

        </div>

        <div class="services__grid">

            <article class="service-card">

                <span class="service-card__number"
                      aria-hidden="true">
                    01
                </span>

                <div class="service-card__icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 24 24">

                        <rect x="3"
                              y="4"
                              width="18"
                              height="14"
                              rx="2" />

                        <path d="M3 8h18" />

                        <path d="M8 21h8" />

                        <path d="M12 18v3" />

                    </svg>

                </div>

                <div class="service-card__content">

                    <h3 class="service-card__title">
                        Sitios web profesionales
                    </h3>

                    <p class="service-card__description">
                        Creamos una presencia digital moderna y clara
                        para que tus clientes conozcan tu negocio
                        y puedan contactarte fácilmente.
                    </p>

                    <ul class="service-card__features">

                        <li>
                            <span aria-hidden="true">
                                ✓
                            </span>

                            Presenta tu negocio profesionalmente
                        </li>

                        <li>
                            <span aria-hidden="true">
                                ✓
                            </span>

                            Muestra tus productos o servicios
                        </li>

                        <li>
                            <span aria-hidden="true">
                                ✓
                            </span>

                            Facilita el contacto con tus clientes
                        </li>

                    </ul>

                </div>

            </article>

            <article class="service-card">

                <span class="service-card__number"
                      aria-hidden="true">
                    02
                </span>

                <div class="service-card__icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 24 24">

                        <rect x="3"
                              y="3"
                              width="7"
                              height="7"
                              rx="1.5" />

                        <rect x="14"
                              y="3"
                              width="7"
                              height="7"
                              rx="1.5" />

                        <rect x="3"
                              y="14"
                              width="7"
                              height="7"
                              rx="1.5" />

                        <rect x="14"
                              y="14"
                              width="7"
                              height="7"
                              rx="1.5" />

                    </svg>

                </div>

                <div class="service-card__content">

                    <h3 class="service-card__title">
                        Sistemas a medida
                    </h3>

                    <p class="service-card__description">
                        Desarrollamos herramientas adaptadas a la forma
                        en que funciona tu negocio para ayudarte a organizar
                        y controlar mejor tus operaciones.
                    </p>

                    <ul class="service-card__features">

                        <li>
                            <span aria-hidden="true">
                                ✓
                            </span>

                            Administración e inventarios
                        </li>

                        <li>
                            <span aria-hidden="true">
                                ✓
                            </span>

                            Pedidos, citas y registros
                        </li>

                        <li>
                            <span aria-hidden="true">
                                ✓
                            </span>

                            Procesos específicos de tu negocio
                        </li>

                    </ul>

                </div>

            </article>

            <article class="service-card">

                <span class="service-card__number"
                      aria-hidden="true">
                    03
                </span>

                <div class="service-card__icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 24 24">

                        <path d="M4 7h10" />

                        <path d="m11 4 3 3-3 3" />

                        <path d="M20 17H10" />

                        <path d="m13 14-3 3 3 3" />

                        <circle cx="5"
                                cy="17"
                                r="2" />

                        <circle cx="19"
                                cy="7"
                                r="2" />

                    </svg>

                </div>

                <div class="service-card__content">

                    <h3 class="service-card__title">
                        Automatización de procesos
                    </h3>

                    <p class="service-card__description">
                        Digitalizamos tareas repetitivas para ayudarte
                        a ahorrar tiempo, reducir errores y simplificar
                        el trabajo cotidiano.
                    </p>

                    <ul class="service-card__features">

                        <li>
                            <span aria-hidden="true">
                                ✓
                            </span>

                            Reduce tareas manuales
                        </li>

                        <li>
                            <span aria-hidden="true">
                                ✓
                            </span>

                            Disminuye errores repetitivos
                        </li>

                        <li>
                            <span aria-hidden="true">
                                ✓
                            </span>

                            Aprovecha mejor tu tiempo
                        </li>

                    </ul>

                </div>

            </article>

        </div>

        <div class="services__guidance">

            <div class="services__guidance-content">

                <div class="services__guidance-icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 24 24">

                        <path d="M8.5 9a3.5 3.5 0 1 1 6.1 2.4c-1.1 1.1-2.6 1.6-2.6 3.1" />

                        <path d="M12 18h.01" />

                        <circle cx="12"
                                cy="12"
                                r="9" />

                    </svg>

                </div>

                <div>

                    <h3 class="services__guidance-title">
                        ¿No sabes cuál necesitas?
                    </h3>

                    <p class="services__guidance-description">
                        No pasa nada. Explícanos qué problema quieres
                        resolver y nosotros te ayudamos a encontrar
                        la mejor opción.
                    </p>

                </div>

            </div>

            <a class="services__guidance-action"
               href="@BrandLinks.WhatsApp"
               target="_blank"
               rel="noopener noreferrer">

                Cuéntanos qué necesitas

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M5 12h14M13 6l6 6-6 6" />

                </svg>

            </a>

        </div>

    </div>

</section>