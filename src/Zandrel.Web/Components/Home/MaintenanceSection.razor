@using Zandrel.Web.Constants

<section id="maintenance"
         class="maintenance section"
         aria-labelledby="maintenance-title">

    <div class="container maintenance__container">

        <div class="maintenance__content">

            <span class="eyebrow">
                Mantenimiento incluido
            </span>

            <h2 id="maintenance-title"
                class="maintenance__title">
                Entregarte el proyecto no significa desaparecer.
            </h2>

            <p class="maintenance__description">
                Si después de la entrega aparece un problema relacionado
                con el funcionamiento que acordamos para tu solución,
                seguimos ahí para corregirlo sin costo adicional.
            </p>

            <p class="maintenance__description">
                Queremos que puedas utilizar lo que desarrollamos con
                tranquilidad, sabiendo que la entrega del proyecto no
                termina automáticamente nuestro respaldo.
            </p>

            <div class="maintenance__highlight">

                <div class="maintenance__highlight-icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 24 24">

                        <path d="M12 3 5 6v5c0 4.8 2.9 8.2 7 10
                        4.1-1.8 7-5.2 7-10V6z" />

                        <path d="m9 12 2 2 4-4" />

                    </svg>

                </div>

                <div>

                    <strong>
                        Respaldamos el funcionamiento acordado.
                    </strong>

                    <span>
                        El mantenimiento incluido es correctivo y aplica
                        sobre la solución originalmente entregada.
                    </span>

                </div>

            </div>

            <a class="maintenance__action"
               href="@BrandLinks.WhatsApp"
               target="_blank"
               rel="noopener noreferrer">

                Hablar con Zandrel

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M5 12h14M13 6l6 6-6 6" />

                </svg>

            </a>

        </div>

        <div class="maintenance__coverage">

            <div class="maintenance-panel maintenance-panel--included">

                <div class="maintenance-panel__header">

                    <div class="maintenance-panel__status
                        maintenance-panel__status--included"
                         aria-hidden="true">

                        <svg viewBox="0 0 24 24">

                            <path d="M20 6 9 17l-5-5" />

                        </svg>

                    </div>

                    <div>

                        <span class="maintenance-panel__eyebrow">
                            Sin costo adicional
                        </span>

                        <h3 class="maintenance-panel__title">
                            Qué cubre el mantenimiento
                        </h3>

                    </div>

                </div>

                <ul class="maintenance-panel__list">

                    <li>

                        <span class="maintenance-panel__list-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M20 6 9 17l-5-5" />

                            </svg>

                        </span>

                        <div>

                            <strong>
                                Corrección de errores
                            </strong>

                            <span>
                                Problemas que impidan que una función
                                originalmente acordada opere correctamente.
                            </span>

                        </div>

                    </li>

                    <li>

                        <span class="maintenance-panel__list-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M20 6 9 17l-5-5" />

                            </svg>

                        </span>

                        <div>

                            <strong>
                                Fallas de la solución entregada
                            </strong>

                            <span>
                                Comportamientos incorrectos atribuibles
                                al desarrollo realizado por Zandrel.
                            </span>

                        </div>

                    </li>

                    <li>

                        <span class="maintenance-panel__list-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M20 6 9 17l-5-5" />

                            </svg>

                        </span>

                        <div>

                            <strong>
                                Ajustes correctivos necesarios
                            </strong>

                            <span>
                                Modificaciones necesarias para recuperar
                                el comportamiento originalmente acordado.
                            </span>

                        </div>

                    </li>

                </ul>

            </div>

            <div class="maintenance-panel maintenance-panel--additional">

                <div class="maintenance-panel__header">

                    <div class="maintenance-panel__status
                        maintenance-panel__status--additional"
                         aria-hidden="true">

                        <svg viewBox="0 0 24 24">

                            <path d="M12 5v14" />
                            <path d="M5 12h14" />

                        </svg>

                    </div>

                    <div>

                        <span class="maintenance-panel__eyebrow">
                            Se cotiza por separado
                        </span>

                        <h3 class="maintenance-panel__title">
                            Qué se considera trabajo nuevo
                        </h3>

                    </div>

                </div>

                <ul class="maintenance-panel__list">

                    <li>

                        <span class="maintenance-panel__list-icon
                            maintenance-panel__list-icon--additional"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M12 5v14" />
                                <path d="M5 12h14" />

                            </svg>

                        </span>

                        <div>

                            <strong>
                                Nuevas funcionalidades
                            </strong>

                            <span>
                                Funciones o características que no formaban
                                parte del alcance originalmente acordado.
                            </span>

                        </div>

                    </li>

                    <li>

                        <span class="maintenance-panel__list-icon
                            maintenance-panel__list-icon--additional"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M12 5v14" />
                                <path d="M5 12h14" />

                            </svg>

                        </span>

                        <div>

                            <strong>
                                Cambios y rediseños
                            </strong>

                            <span>
                                Modificaciones solicitadas posteriormente
                                sobre diseño, comportamiento o alcance.
                            </span>

                        </div>

                    </li>

                    <li>

                        <span class="maintenance-panel__list-icon
                            maintenance-panel__list-icon--additional"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M12 5v14" />
                                <path d="M5 12h14" />

                            </svg>

                        </span>

                        <div>

                            <strong>
                                Nuevas integraciones
                            </strong>

                            <span>
                                Conexiones posteriores con otros sistemas,
                                plataformas o servicios externos.
                            </span>

                        </div>

                    </li>

                    <li>

                        <span class="maintenance-panel__list-icon
                            maintenance-panel__list-icon--additional"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M12 5v14" />
                                <path d="M5 12h14" />

                            </svg>

                        </span>

                        <div>

                            <strong>
                                Servicios y costos de terceros
                            </strong>

                            <span>
                                Dominios, hosting, licencias, plataformas
                                externas u otros servicios contratados.
                            </span>

                        </div>

                    </li>

                </ul>

            </div>

            <div class="maintenance__clarification">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <circle cx="12"
                            cy="12"
                            r="9" />

                    <path d="M12 11v5" />
                    <path d="M12 8h.01" />

                </svg>

                <p>
                    Si no estás seguro de si una solicitud forma parte
                    del mantenimiento o representa una mejora nueva,
                    te lo explicamos antes de realizar cualquier trabajo.
                </p>

            </div>

        </div>

    </div>

</section>