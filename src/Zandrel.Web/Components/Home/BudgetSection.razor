@using Zandrel.Web.Constants

<section class="budget section"
         aria-labelledby="budget-title">

    <div class="container">

        <div class="budget__panel">

            <div class="budget__content">

                <span class="eyebrow">
                    Una solución a tu medida
                </span>

                <h2 id="budget-title"
                    class="budget__title">
                    Tu presupuesto también forma parte de la solución.
                </h2>

                <p class="budget__description">
                    Cuéntanos qué quieres lograr y cuánto tienes disponible
                    para invertir. Analizamos tu necesidad y buscamos una
                    alternativa realista que priorice lo más importante
                    para tu negocio.
                </p>

                <ul class="budget__benefits">

                    <li class="budget__benefit">

                        <span class="budget__benefit-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M20 6 9 17l-5-5" />

                            </svg>

                        </span>

                        <div>

                            <strong>
                                Priorizamos lo que realmente necesitas
                            </strong>

                            <span>
                                Empezamos por aquello que genera mayor valor
                                para tu negocio.
                            </span>

                        </div>

                    </li>

                    <li class="budget__benefit">

                        <span class="budget__benefit-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M20 6 9 17l-5-5" />

                            </svg>

                        </span>

                        <div>

                            <strong>
                                Evitamos funcionalidades innecesarias
                            </strong>

                            <span>
                                No agregamos complejidad únicamente para
                                aumentar el alcance del proyecto.
                            </span>

                        </div>

                    </li>

                    <li class="budget__benefit">

                        <span class="budget__benefit-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M20 6 9 17l-5-5" />

                            </svg>

                        </span>

                        <div>

                            <strong>
                                Definimos todo antes de comenzar
                            </strong>

                            <span>
                                Conoces qué incluye la propuesta y qué vamos
                                a desarrollar antes de iniciar.
                            </span>

                        </div>

                    </li>

                </ul>

                <a class="budget__action"
                   href="@BrandLinks.WhatsApp"
                   target="_blank"
                   rel="noopener noreferrer">

                    Cuéntanos tu idea por WhatsApp

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M5 12h14M13 6l6 6-6 6" />

                    </svg>

                </a>

            </div>

            <div class="budget__visual"
                 aria-hidden="true">

                <div class="budget-flow">

                    <div class="budget-flow__header">

                        <div>

                            <span class="budget-flow__eyebrow">
                                Tu proyecto
                            </span>

                            <strong>
                                Encontramos el equilibrio adecuado.
                            </strong>

                        </div>

                        <img src="images/brand/zandrel-mark-transparent.png"
                             alt="" />

                    </div>

                    <div class="budget-flow__steps">

                        <div class="budget-step">

                            <span class="budget-step__number">
                                01
                            </span>

                            <div class="budget-step__content">

                                <span>
                                    Entendemos
                                </span>

                                <strong>
                                    Tu necesidad
                                </strong>

                            </div>

                        </div>

                        <span class="budget-flow__connector"></span>

                        <div class="budget-step">

                            <span class="budget-step__number">
                                02
                            </span>

                            <div class="budget-step__content">

                                <span>
                                    Definimos
                                </span>

                                <strong>
                                    Tus prioridades
                                </strong>

                            </div>

                        </div>

                        <span class="budget-flow__connector"></span>

                        <div class="budget-step">

                            <span class="budget-step__number">
                                03
                            </span>

                            <div class="budget-step__content">

                                <span>
                                    Consideramos
                                </span>

                                <strong>
                                    Tu presupuesto
                                </strong>

                            </div>

                        </div>

                    </div>

                    <div class="budget-flow__result">

                        <div class="budget-flow__result-icon">

                            <svg viewBox="0 0 24 24">

                                <path d="M20 6 9 17l-5-5" />

                            </svg>

                        </div>

                        <div>

                            <span>
                                Resultado
                            </span>

                            <strong>
                                Una solución adecuada para tu negocio
                            </strong>

                        </div>

                    </div>

                    <div class="budget-flow__note">

                        <svg viewBox="0 0 24 24">

                            <circle cx="12"
                                    cy="12"
                                    r="9" />

                            <path d="M12 11v5" />

                            <path d="M12 8h.01" />

                        </svg>

                        <span>
                            Si el proyecto puede simplificarse sin perder
                            su objetivo, te lo diremos.
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>