@using Zandrel.Web.Constants

<section id="process"
         class="process section"
         aria-labelledby="process-title">

    <div class="container process__container">

        <div class="process__intro">

            <span class="eyebrow">
                Cómo trabajamos
            </span>

            <h2 id="process-title"
                class="process__title">
                Tú conoces tu negocio.
                Nosotros nos encargamos del resto.
            </h2>

            <p class="process__description">
                No necesitas llegar con una solución definida ni conocer
                términos técnicos. Empezamos escuchando qué quieres lograr
                y te acompañamos durante todo el proceso.
            </p>

            <div class="process__note">

                <div class="process__note-icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 24 24">

                        <path d="M8 10h8" />
                        <path d="M8 14h5" />

                        <path d="M21 12a8.5 8.5 0 0 1-9 8.5
                        9.5 9.5 0 0 1-4-.9
                        L3 21l1.5-4.5
                        A8.5 8.5 0 1 1 21 12Z" />

                    </svg>

                </div>

                <div>

                    <strong>
                        Hablamos de tu negocio, no de tecnicismos.
                    </strong>

                    <span>
                        Nosotros traducimos tus necesidades en decisiones
                        tecnológicas.
                    </span>

                </div>

            </div>

            <a class="process__action"
               href="@BrandLinks.WhatsApp"
               target="_blank"
               rel="noopener noreferrer">

                Cuéntanos qué necesitas

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M5 12h14M13 6l6 6-6 6" />

                </svg>

            </a>

        </div>

        <div class="process__timeline">

            <ol class="process-list">

                <li class="process-step">

                    <div class="process-step__indicator"
                         aria-hidden="true">

                        <span class="process-step__number">
                            01
                        </span>

                        <span class="process-step__line"></span>

                    </div>

                    <div class="process-step__body">

                        <div class="process-step__icon"
                             aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M8 10h8" />
                                <path d="M8 14h5" />

                                <path d="M21 12a8.5 8.5 0 0 1-9 8.5
                                9.5 9.5 0 0 1-4-.9
                                L3 21l1.5-4.5
                                A8.5 8.5 0 1 1 21 12Z" />

                            </svg>

                        </div>

                        <div>

                            <span class="process-step__label">
                                Primero te escuchamos
                            </span>

                            <h3 class="process-step__title">
                                Cuéntanos tu problema o idea
                            </h3>

                            <p class="process-step__description">
                                Explícanos qué quieres mejorar, resolver
                                o hacer diferente en tu negocio con tus
                                propias palabras.
                            </p>

                        </div>

                    </div>

                </li>

                <li class="process-step">

                    <div class="process-step__indicator"
                         aria-hidden="true">

                        <span class="process-step__number">
                            02
                        </span>

                        <span class="process-step__line"></span>

                    </div>

                    <div class="process-step__body">

                        <div class="process-step__icon"
                             aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <circle cx="11"
                                        cy="11"
                                        r="7" />

                                <path d="m20 20-4-4" />

                                <path d="M8 11h6" />
                                <path d="M11 8v6" />

                            </svg>

                        </div>

                        <div>

                            <span class="process-step__label">
                                Nosotros lo analizamos
                            </span>

                            <h3 class="process-step__title">
                                Encontramos la solución adecuada
                            </h3>

                            <p class="process-step__description">
                                Evaluamos tu necesidad y determinamos
                                qué solución puede resolverla de manera
                                práctica, evitando complejidad innecesaria.
                            </p>

                        </div>

                    </div>

                </li>

                <li class="process-step">

                    <div class="process-step__indicator"
                         aria-hidden="true">

                        <span class="process-step__number">
                            03
                        </span>

                        <span class="process-step__line"></span>

                    </div>

                    <div class="process-step__body">

                        <div class="process-step__icon"
                             aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M5 4h14v16H5z" />

                                <path d="M8 8h8" />
                                <path d="M8 12h5" />

                                <path d="m14 16 1.5 1.5L19 14" />

                            </svg>

                        </div>

                        <div>

                            <span class="process-step__label">
                                Todo queda claro
                            </span>

                            <h3 class="process-step__title">
                                Acordamos alcance y presupuesto
                            </h3>

                            <p class="process-step__description">
                                Antes de comenzar sabes qué desarrollaremos,
                                qué incluye la propuesta y cuál será el costo
                                acordado.
                            </p>

                        </div>

                    </div>

                </li>

                <li class="process-step">

                    <div class="process-step__indicator"
                         aria-hidden="true">

                        <span class="process-step__number">
                            04
                        </span>

                        <span class="process-step__line"></span>

                    </div>

                    <div class="process-step__body">

                        <div class="process-step__icon"
                             aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="m8 9-4 3 4 3" />
                                <path d="m16 9 4 3-4 3" />
                                <path d="m14 5-4 14" />

                            </svg>

                        </div>

                        <div>

                            <span class="process-step__label">
                                Manos a la obra
                            </span>

                            <h3 class="process-step__title">
                                Desarrollamos tu proyecto
                            </h3>

                            <p class="process-step__description">
                                Construimos la solución manteniendo
                                comunicación contigo para que conozcas
                                el avance de tu proyecto.
                            </p>

                        </div>

                    </div>

                </li>

                <li class="process-step process-step--last">

                    <div class="process-step__indicator"
                         aria-hidden="true">

                        <span class="process-step__number">
                            05
                        </span>

                    </div>

                    <div class="process-step__body">

                        <div class="process-step__icon"
                             aria-hidden="true">

                            <svg viewBox="0 0 24 24">

                                <path d="M14.7 6.3a4 4 0 0 0-5 5
                                L3 18v3h3l6.7-6.7
                                a4 4 0 0 0 5-5
                                l-2.5 2.5-3-3z" />

                            </svg>

                        </div>

                        <div>

                            <span class="process-step__label">
                                No termina con la entrega
                            </span>

                            <h3 class="process-step__title">
                                Seguimos contigo
                            </h3>

                            <p class="process-step__description">
                                Después de entregar tu proyecto continuamos
                                respaldando la solución mediante el
                                mantenimiento incluido.
                            </p>

                        </div>

                    </div>

                </li>

            </ol>

        </div>

    </div>

</section>